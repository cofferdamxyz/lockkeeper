{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [{ "type": "command", "command": "if [ -n \"$LOCKKEEPER_HOOK\" ]; then node \"$LOCKKEEPER_HOOK\" session-start; fi", "timeout": 15 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "if [ -n \"$LOCKKEEPER_HOOK\" ]; then node \"$LOCKKEEPER_HOOK\" pre-tool; fi", "timeout": 10 }]
      }
    ]
  }
}
