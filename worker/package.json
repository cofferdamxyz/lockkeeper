{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development --test-scheduled",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "pnpm run types && tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.node.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply lockkeeper-cofferdam --local",
    "db:migrate": "wrangler d1 migrations apply lockkeeper-cofferdam --remote"
  },
  "dependencies": {
    "hono": "4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
